---
import type { CollectionEntry } from "astro:content";

type Props = {
  entry: CollectionEntry<"bookmarks">;
};

const { entry } = Astro.props as Props;

const externalUrl = entry.data.url;
const internalUrl = `/bookmarks/${entry.id}`;

const text = entry.data.excerpt;

const readAt = entry.data.readDate
  ? new Date(entry.data.readDate).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
---

<div
  class="not-prose relative rounded-lg border border-black/15 px-4 py-3 transition-colors duration-300 ease-in-out dark:border-white/20"
>
  <div class="flex flex-col gap-2">
    <!-- Title + external icon -->
    <div class="flex items-start gap-2">
      <a
        href={externalUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-1 font-semibold hover:underline"
      >
        {entry.data.title}

        <!-- External link icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-4 fill-none stroke-current stroke-2 opacity-70 transition-opacity group-hover:opacity-100"
        >
          <path d="M14 3h7v7" />
          <path d="M10 14L21 3" />
          <path d="M21 14v7h-7" />
          <path d="M3 10v11h11" />
        </svg>
      </a>
    </div>

    <!-- Description / excerpt -->
    {text && (
      <div class="text-sm text-black/70 dark:text-white/70">
        {text}
      </div>
    )}

    <!-- Read date (internal link) -->
    {readAt && (
      <a
        href={internalUrl}
        class="inline-flex items-center gap-1 text-xs text-black/50 hover:underline dark:text-white/50"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="size-3 fill-none stroke-current stroke-2"
        >
          <rect x="3" y="4" width="18" height="18" rx="2" />
          <line x1="16" y1="2" x2="16" y2="6" />
          <line x1="8" y1="2" x2="8" y2="6" />
          <line x1="3" y1="10" x2="21" y2="10" />
        </svg>

        {readAt}
      </a>
    )}
  </div>
</div>

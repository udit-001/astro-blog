---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BookmarkCard from "@/components/BookmarkCard.astro";
import { BOOKMARKS } from "@consts";

const bookmarks = (await getCollection("bookmarks"))
  .sort((a, b) => b.data.readDate.valueOf() - a.data.readDate.valueOf());
---

<Layout title={BOOKMARKS.TITLE} description={BOOKMARKS.DESCRIPTION}>
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate font-semibold text-black dark:text-white">
          Bookmarks
        </div>
        <ul class="animate not-prose flex flex-col gap-4">
          {
            bookmarks.map((bookmark) => (
              <li>
                    <BookmarkCard
                        entry={bookmark}
                    />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>

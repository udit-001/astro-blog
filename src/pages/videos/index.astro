---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import VideoCard from "@components/VideoCard.astro";
import { VIDEOS } from "@consts";

const videos = (await getCollection("videos"))
  .filter((video) => !video.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Layout title={VIDEOS.TITLE} description={VIDEOS.DESCRIPTION} image="/og-image/videos.png">
  <Container>
    <aside data-pagefind-ignore>
      <div class="space-y-10">
        <div class="animate font-semibold text-black dark:text-white">
          Videos
        </div>
        <ul class="animate not-prose grid grid-cols-1 gap-4 sm:grid-cols-2">
          {
            videos.map((video) => (
              <li>
                <VideoCard entry={video} />
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </Container>
</Layout>

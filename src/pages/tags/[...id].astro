---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import BookmarkCard from "@components/BookmarkCard.astro";
import VideoCard from "@components/VideoCard.astro";
import BackToPrevious from "@components/BackToPrevious.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const bookmarks = await getCollection("bookmarks");
  const prompts = await getCollection("prompts", ({ data }) => !data.draft);
  const videos = await getCollection("videos", ({ data }) => !data.draft);

  // Get unique tags
  const tags = [
    ...new Set([
      ...posts.flatMap((post) => post.data.tags || []),
      ...bookmarks.flatMap((bookmark) => bookmark.data.tags || []),
      ...prompts.flatMap((prompt) => prompt.data.tags || []),
      ...videos.flatMap((video) => video.data.tags || []),
    ]),
  ].sort();
  // Create paths for each tag
  return tags.map((tag) => ({
    params: { id: tag },
    props: {
      posts: posts.filter((post) => post.data.tags?.includes(tag)),
      prompts: prompts.filter((prompt) => prompt.data.tags?.includes(tag)),
      bookmarks: bookmarks.filter((bookmark) => bookmark.data.tags?.includes(tag)),
      videos: videos.filter((video) => video.data.tags?.includes(tag)),
    },
  }));
}

const { id } = Astro.params;
const { posts, bookmarks, prompts, videos } = Astro.props;

// Sort posts by date, most recent first
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const sortedBookmarks = bookmarks.sort(
  (a, b) => new Date(b.data.readDate).getTime() - new Date(a.data.readDate).getTime(),
);
const sortedPrompts = prompts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
const sortedVideos = videos.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
);
---

<Layout title={`Tag: ${id}`} description={`Posts with the tag: ${id}`} image={`/og-image/tags/${id}.png`}>
  <Container>
    <div class="space-y-10" data-pagefind-ignore>
      <BackToPrevious href="/tags"> All tags </BackToPrevious>
      {sortedPosts.length > 0 && (
        <h1 class="animate font-semibold text-black dark:text-white">
          Posts tagged with "{id}"
        </h1>
        <ul class="animate flex flex-col gap-4">
          {sortedPosts.map((post) => <ArrowCard entry={post} />)}
        </ul>
      )}
      {sortedBookmarks.length > 0 && (
        <h1 class="animate font-semibold text-black dark:text-white">
          Bookmarks tagged with "{id}"
        </h1>
        <ul class="animate flex flex-col gap-4">
        {sortedBookmarks.map((bookmark) => <BookmarkCard entry={bookmark} />)}
      </ul>
    )}
    {sortedPrompts.length > 0 && (
      <h1 class="animate font-semibold text-black dark:text-white">
        Prompts tagged with "{id}"
      </h1>
      <ul class="animate flex flex-col gap-4">
        {sortedPrompts.map((prompt) => <ArrowCard entry={prompt} />)}
      </ul>
    )}
    {sortedVideos.length > 0 && (
      <h1 class="animate font-semibold text-black dark:text-white">
        Videos tagged with "{id}"
      </h1>
      <ul class="animate grid grid-cols-1 gap-4 sm:grid-cols-2">
        {sortedVideos.map((video) => (
          <li>
            <VideoCard entry={video} />
          </li>
        ))}
      </ul>
    )}
    </div>
  </Container>
</Layout>
